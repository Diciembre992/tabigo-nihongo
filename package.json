{
  "name": "tabigo-nihongo",
  "type": "module",
  "version": "1.0.0",
  "description": "Aplicación interactiva en Astro para aprender japonés básico y de supervivencia para viajes",
  "scripts": {
    "dev": "astro dev --host",
    "start": "node server.mjs",
    "serve": "astro build && node server.mjs",
    "build": "astro build",
    "preview": "node server.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:4325"
  },
  "dependencies": {
    "astro": "^5.1.0"
  }
}

