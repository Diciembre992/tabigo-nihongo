---
import Layout from '../layouts/Layout.astro';
import HeaderGamification from '../components/HeaderGamification.astro';
import PhraseBuilder from '../components/PhraseBuilder.astro';
import VisualCommonWords from '../components/VisualCommonWords.astro';
import VocabDeck from '../components/VocabDeck.astro';
import DynamicKanaTable from '../components/DynamicKanaTable.astro';
import CalligraphyDojo from '../components/CalligraphyDojo.astro';
import TravelSimulator from '../components/TravelSimulator.astro';
import QuickMinigame from '../components/QuickMinigame.astro';
---

<Layout title="TabiGo (旅語) · Japonés Básico Paso a Paso">
  <HeaderGamification />

  <main class="m3-main">
    <!-- VISTA 1: INICIO SIMPLE · TRES PASOS DESPLEGABLES -->
    <section id="hub-view" class="hub-container view-animate">
      <div class="zen-welcome">
        <h1 class="welcome-title">¿Qué aprendemos hoy?</h1>
        <p class="welcome-subtitle">Despliega un paso para ver sus actividades.</p>

        <div class="micro-hook-pill">
          <strong class="micro-jp">すみません</strong>
          <span class="micro-phonetic">"Su-mi-ma-sén" · Disculpe</span>
          <button type="button" class="micro-play-btn" id="hero-instant-listen" title="Escuchar pronunciación">
            🔊
          </button>
        </div>
      </div>

      <!-- Resumen compacto de memoria -->
      <div class="hub-stats" aria-label="Resumen de tu progreso">
        <div class="hub-stat">
          <strong id="hub-mastered-count">0</strong>
          <span>Dominadas</span>
        </div>
        <div class="hub-stat">
          <strong id="hub-learning-count">0</strong>
          <span>En progreso</span>
        </div>
        <div class="hub-stat">
          <strong id="hub-weak-count">0</strong>
          <span>Por fortalecer</span>
        </div>
        <button
          type="button"
          class="text-action-btn"
          id="hub-practice-weak-btn"
          title="Ir directo a repasar lo que necesitas fortalecer"
        >
          🎯 Repasar
        </button>
      </div>

      <!-- PASOS DESPLEGABLES -->
      <div class="steps-accordion">
        <!-- PASO 1 -->
        <details class="step-acc" name="hub-steps" open>
          <summary>
            <span class="step-num">1</span>
            <span class="step-head">
              <strong>Hablar y vocabulario</strong>
              <small id="hub-step1-level-badge">Nivel 0 · Intro</small>
            </span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>

          <div class="step-body">
            <div class="level-row" role="group" aria-label="Saltar a un nivel de gramática">
              <span class="level-row-label">Gramática por niveles</span>
              <div class="level-chips">
                <button type="button" class="level-chip" data-open-grammar-level="intro">
                  Intro <small data-hub-glevel-count="intro">0/4</small>
                </button>
                <button type="button" class="level-chip" data-open-grammar-level="nivel-1">
                  Nivel 1 <small data-hub-glevel-count="nivel-1">0/5</small>
                </button>
                <button type="button" class="level-chip" data-open-grammar-level="nivel-2">
                  Nivel 2 <small data-hub-glevel-count="nivel-2">0/5</small>
                </button>
                <button type="button" class="level-chip" data-open-grammar-level="nivel-3">
                  Nivel 3 <small data-hub-glevel-count="nivel-3">0/5</small>
                </button>
              </div>
            </div>

            <button type="button" class="sub-row" data-open-category="hablar" data-open-activity="builder">
              <span class="sub-ico">🧱</span>
              <span class="sub-text"><strong>Constructor de frases</strong><small>Gramática paso a paso</small></span>
              <span class="sub-arrow">›</span>
            </button>
            <button type="button" class="sub-row" data-open-category="hablar" data-open-activity="visual-words">
              <span class="sub-ico">🖼️</span>
              <span class="sub-text"><strong>Palabras ilustradas</strong><small>80 palabras con imagen</small></span>
              <span class="sub-arrow">›</span>
            </button>
            <button type="button" class="sub-row" data-open-category="hablar" data-open-activity="vocab">
              <span class="sub-ico">🎵</span>
              <span class="sub-text"><strong>Expresiones y melodía</strong><small>Frases útiles con entonación</small></span>
              <span class="sub-arrow">›</span>
            </button>
          </div>
        </details>

        <!-- PASO 2 -->
        <details class="step-acc" name="hub-steps">
          <summary>
            <span class="step-num green">2</span>
            <span class="step-head">
              <strong>Leer y escribir</strong>
              <small id="hub-step2-level-badge">Nivel 0 · Intro</small>
            </span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>

          <div class="step-body">
            <div class="mini-progress" aria-hidden="true">
              <div class="mini-progress-fill" id="hub-step2-bar" style="width: 8%"></div>
            </div>

            <button type="button" class="sub-row" data-open-category="escritura" data-open-activity="kana-table">
              <span class="sub-ico">📊</span>
              <span class="sub-text"><strong>Tabla Hiragana · Katakana</strong><small>Con audio y reto del oído</small></span>
              <span class="sub-arrow">›</span>
            </button>
            <button type="button" class="sub-row" data-open-category="escritura" data-open-activity="dojo">
              <span class="sub-ico">🖌️</span>
              <span class="sub-text"><strong>Caligrafía y carteles</strong><small>Traza caracteres y kanji de calle</small></span>
              <span class="sub-arrow">›</span>
            </button>
          </div>
        </details>

        <!-- PASO 3 -->
        <details class="step-acc" name="hub-steps">
          <summary>
            <span class="step-num amber">3</span>
            <span class="step-head">
              <strong>Practicar en viaje</strong>
              <small id="hub-step3-level-badge">Nivel 0 · Intro</small>
            </span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>

          <div class="step-body">
            <button type="button" class="sub-row" data-open-category="practica" data-open-activity="simulator">
              <span class="sub-ico">⛩️</span>
              <span class="sub-text"><strong>Simulador de viaje</strong><small>Conversaciones reales por niveles</small></span>
              <span class="sub-arrow">›</span>
            </button>
            <button type="button" class="sub-row" data-open-category="practica" data-open-activity="minigame">
              <span class="sub-ico">⚡</span>
              <span class="sub-text"><strong>Reto y flashcards</strong><small>Pon a prueba tus reflejos</small></span>
              <span class="sub-arrow">›</span>
            </button>
          </div>
        </details>
      </div>
    </section>

    <!-- VISTA 2: ESPACIO DE TRABAJO (UNA SOLA ACTIVIDAD A LA VEZ) -->
    <section id="workspace-view" class="workspace-container" hidden>
      <div class="workspace-nav-shell">
        <div class="crumbs" id="workspace-crumb">Paso 1 · Hablar y vocabulario</div>

        <div class="sub-activity-tabs" id="sub-tabs-hablar">
          <button type="button" class="sub-tab active" data-switch-activity="builder">Constructor</button>
          <button type="button" class="sub-tab" data-switch-activity="visual-words">Palabras ilustradas</button>
          <button type="button" class="sub-tab" data-switch-activity="vocab">Expresiones</button>
        </div>

        <div class="sub-activity-tabs" id="sub-tabs-escritura" hidden>
          <button type="button" class="sub-tab active" data-switch-activity="kana-table">Tabla Kana</button>
          <button type="button" class="sub-tab" data-switch-activity="dojo">Caligrafía</button>
        </div>

        <div class="sub-activity-tabs" id="sub-tabs-practica" hidden>
          <button type="button" class="sub-tab active" data-switch-activity="simulator">Simulador</button>
          <button type="button" class="sub-tab" data-switch-activity="minigame">Reto Yamanote</button>
        </div>
      </div>

      <div class="activity-pane view-animate" id="pane-builder">
        <PhraseBuilder />
      </div>

      <div class="activity-pane view-animate" id="pane-visual-words" hidden>
        <VisualCommonWords />
      </div>

      <div class="activity-pane view-animate" id="pane-vocab" hidden>
        <VocabDeck />
      </div>

      <div class="activity-pane view-animate" id="pane-kana-table" hidden>
        <DynamicKanaTable />
      </div>

      <div class="activity-pane view-animate" id="pane-dojo" hidden>
        <CalligraphyDojo />
      </div>

      <div class="activity-pane view-animate" id="pane-simulator" hidden>
        <TravelSimulator />
      </div>

      <div class="activity-pane view-animate" id="pane-minigame" hidden>
        <QuickMinigame />
      </div>

      <div class="next-step-footer">
        <button type="button" class="ghost-back-btn" id="footer-back-hub">← Inicio</button>

        <button type="button" class="m3-filled-next-btn" id="next-step-action-btn">
          Siguiente →
        </button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { initTabiGoApp } from '../scripts/appClient';

  document.addEventListener('DOMContentLoaded', () => {
    initTabiGoApp();
  });
</script>

<style>
  .m3-main {
    max-width: 880px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .hub-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hub-container[hidden],
  .workspace-container[hidden],
  .activity-pane[hidden],
  .sub-activity-tabs[hidden] {
    display: none !important;
  }

  /* BIENVENIDA */
  .zen-welcome {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .welcome-title {
    font-family: var(--font-ui);
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    font-weight: 600;
    color: var(--md-on-surface);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .welcome-subtitle {
    font-size: 0.98rem;
    color: var(--md-on-surface-variant);
  }

  .micro-hook-pill {
    margin-top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    border: 1px solid var(--md-outline-variant);
    border-radius: var(--radius-pill);
    background: var(--md-surface);
  }

  .micro-jp {
    font-family: var(--font-serif-jp);
    font-size: 1.1rem;
    color: var(--md-primary);
  }

  .micro-phonetic {
    font-size: 0.82rem;
    color: var(--md-on-surface-variant);
  }

  .micro-play-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--md-primary-container);
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease;
  }

  .micro-play-btn:hover {
    transform: scale(1.08);
  }

  /* RESUMEN COMPACTO */
  .hub-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hub-stat {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--md-surface-low);
    font-size: 0.82rem;
    color: var(--md-on-surface-variant);
  }

  .hub-stat strong {
    font-size: 1rem;
    color: var(--md-on-surface);
  }

  .text-action-btn {
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--md-primary);
    transition: background 0.18s ease;
  }

  .text-action-btn:hover {
    background: var(--md-primary-container);
  }

  /* PASOS DESPLEGABLES */
  .steps-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step-acc {
    background: var(--md-surface);
    border: 1px solid var(--md-outline-variant);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .step-acc[open] {
    border-color: var(--md-outline);
    box-shadow: var(--shadow-soft);
  }

  .step-acc summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    cursor: pointer;
    user-select: none;
  }

  .step-acc summary::-webkit-details-marker {
    display: none;
  }

  .step-acc summary:hover {
    background: var(--md-surface-low);
  }

  .step-num {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    background: var(--md-primary-container);
    color: var(--md-on-primary-container);
  }

  .step-num.green {
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
  }

  .step-num.amber {
    background: var(--md-tertiary-container);
    color: var(--md-tertiary);
  }

  .step-head {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .step-head strong {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--md-on-surface);
  }

  .step-head small {
    font-size: 0.8rem;
    color: var(--md-muted);
  }

  .chevron {
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--md-muted);
    border-bottom: 2px solid var(--md-muted);
    transform: rotate(45deg);
    transition: transform 0.25s ease;
    margin-right: 0.35rem;
  }

  .step-acc[open] .chevron {
    transform: rotate(-135deg);
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.25rem 0.6rem 0.75rem;
    border-top: 1px solid var(--md-outline-variant);
    animation: fadeSlideUp 0.25s ease;
  }

  .level-row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.75rem 0.55rem 0.5rem;
  }

  .level-row-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--md-muted);
  }

  .level-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .level-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--md-outline-variant);
    background: var(--md-surface);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--md-on-surface);
    transition: all 0.16s ease;
  }

  .level-chip small {
    color: var(--md-muted);
    font-weight: 600;
  }

  .level-chip:hover {
    background: var(--md-primary-container);
    border-color: transparent;
  }

  .mini-progress {
    height: 4px;
    margin: 0.85rem 0.55rem 0.4rem;
    background: var(--md-surface-container);
    border-radius: 99px;
    overflow: hidden;
  }

  .mini-progress-fill {
    height: 100%;
    background: var(--md-secondary);
    border-radius: 99px;
    transition: width 0.3s ease;
  }

  .sub-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.7rem 0.55rem;
    border-radius: var(--radius-sm);
    text-align: left;
    color: var(--md-on-surface);
    transition: background 0.16s ease;
  }

  .sub-row:hover {
    background: var(--md-surface-low);
  }

  .sub-ico {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 12px;
    background: var(--md-surface-low);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .sub-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .sub-text strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sub-text small {
    font-size: 0.78rem;
    color: var(--md-muted);
  }

  .sub-arrow {
    font-size: 1.4rem;
    color: var(--md-muted);
    line-height: 1;
  }

  /* ESPACIO DE TRABAJO */
  .workspace-nav-shell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .crumbs {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--md-muted);
    letter-spacing: 0.02em;
  }

  .sub-activity-tabs {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--md-outline-variant);
    width: 100%;
  }

  .sub-tab {
    padding: 0.6rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--md-on-surface-variant);
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    border-radius: 8px 8px 0 0;
    transition: all 0.16s ease;
  }

  .sub-tab:hover {
    background: var(--md-surface-low);
  }

  .sub-tab.active {
    color: var(--md-primary);
    border-bottom-color: var(--md-primary);
  }

  /* PIE DE SIGUIENTE PASO */
  .next-step-footer {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--md-outline-variant);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ghost-back-btn {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--md-on-surface-variant);
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
  }

  .ghost-back-btn:hover {
    background: var(--md-surface-low);
    color: var(--md-on-surface);
  }

  .m3-filled-next-btn {
    background: var(--md-primary);
    color: var(--md-on-primary);
    padding: 0.65rem 1.3rem;
    border-radius: var(--radius-pill);
    font-size: 0.88rem;
    font-weight: 600;
    transition: filter 0.2s ease, transform 0.15s ease;
  }

  .m3-filled-next-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .m3-main {
      padding: 1.25rem 0.85rem 3.5rem;
    }

    .step-acc summary {
      padding: 0.9rem 0.9rem;
      gap: 0.7rem;
    }

    .sub-activity-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .sub-activity-tabs::-webkit-scrollbar {
      display: none;
    }

    .sub-tab {
      white-space: nowrap;
      padding: 0.6rem 0.8rem;
    }

    .next-step-footer {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .m3-filled-next-btn,
    .ghost-back-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
